# --- Personal / runtime config (NEVER published) ---------------------------
# Per-install runtime config; defaults ship as default_config.yaml.
# (vibe_trading currently ships only defaults — no config.json yet.)
config.json
config.json.before-*.bak

# --- Local pre-edit backups (pre-theme-break migration leftovers) ------------
*.bak
*.before-*.bak
*.pre_*.bak

# --- Runtime toggle / disabled-flag state -----------------------------------
.toggle-*
.disabled

# --- Uploaded journal CSVs (runtime user data, never publish) ----------------
# api/journal_upload.py stores broker-export CSVs here. Phase 8.
journal_uploads/

# --- Market Watch rules (runtime user data, never publish) ------------------
# api/watch.py persists price-alert rules here (Phase 9).
watch_rules.json

